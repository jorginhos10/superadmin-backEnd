DB_HOST=localhost
DB_PORT=5433
DB_NAME=superadmin
DB_USER=chefcontrol
DB_PASSWORD=changeme

# Access to the shared tenant database — each restaurant is an owner
# account there (usuarios.propietario = true). Needs UPDATE on usuarios
# for the comercio actions (activo, verificado, nombre, email), not just SELECT.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5433
TENANT_DB_NAME=chefcontrol
TENANT_DB_USER=chefcontrol
TENANT_DB_PASSWORD=changeme

CORS_ORIGINS=http://localhost:4200

JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=480

# "Entrar como" — server-to-server call into chefcontrol-backend's
# /auth/impersonate. Secret must match chefcontrol-backend's .env.
CHEFCONTROL_API_URL=http://localhost:8000
CHEFCONTROL_FRONTEND_URL=http://localhost:4200
CHEFCONTROL_SERVICE_SECRET=changeme
