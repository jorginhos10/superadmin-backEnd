[Unit]
Description=ChefControl SuperAdmin FastAPI backend
After=network.target

[Service]
Type=simple
User=superadmin
Group=superadmin
WorkingDirectory=/opt/chefcontrol-superadmin-backend
EnvironmentFile=/opt/chefcontrol-superadmin-backend/.env
ExecStart=/opt/chefcontrol-superadmin-backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=on-failure
RestartSec=3

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
