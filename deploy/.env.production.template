# Fill in the blanks and copy this to /opt/chefcontrol-superadmin-backend/.env
# on the EC2 instance. Points at its own RDS database, separate from the
# tenant-facing chefcontrol-backend database.

DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=superadmin
DB_USER=REPLACE_WITH_RDS_MASTER_USER
DB_PASSWORD=REPLACE_WITH_RDS_MASTER_PASSWORD

# Access to the shared tenant database (same RDS instance as
# chefcontrol-backend, database "chefcontrol") — each restaurant is an
# owner account there (usuarios.propietario = true). Needs UPDATE on
# usuarios (activo, verificado, nombre, email) for the comercio actions,
# not just SELECT.
TENANT_DB_HOST=REPLACE_WITH_RDS_ENDPOINT
TENANT_DB_PORT=5432
TENANT_DB_NAME=chefcontrol
TENANT_DB_USER=REPLACE_WITH_RDS_USER
TENANT_DB_PASSWORD=REPLACE_WITH_RDS_PASSWORD

CORS_ORIGINS=REPLACE_WITH_SUPERADMIN_FRONTEND_ORIGIN

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_FRESH_GENERATED_SECRET
JWT_EXPIRE_MINUTES=480

# "Entrar como" — server-to-server call into chefcontrol-backend's
# /auth/impersonate. Secret must match chefcontrol-backend's .env.
CHEFCONTROL_API_URL=REPLACE_WITH_CHEFCONTROL_BACKEND_URL
CHEFCONTROL_FRONTEND_URL=REPLACE_WITH_CHEFCONTROL_FRONTEND_URL
CHEFCONTROL_SERVICE_SECRET=REPLACE_WITH_FRESH_GENERATED_SECRET
